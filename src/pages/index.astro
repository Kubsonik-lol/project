---
import { Image } from "astro:assets";
import Button88x31 from "../button88x31.astro";
import Base from "../base.astro";
import Seperator from "../seperator.astro";
import trafish from "../images/travis-scott-fish.jpg";
---

<Base>
  <div class="parent">
    <div class="header">
      <Image
        alt="Noemi's avatar"
        class="avatar"
        src="https://dp.nea.moe/avatar/776037479094550529.png"
        width={800}
        height={800}
      />
      <h1>Noemi's site</h1>
    </div>
    <Seperator />
    <h1>Welcome :3</h1>
    <div class="aboutme">
      <Image src={trafish} height="159" width="318" alt="Trafish Scott" />
      <p>
        Hi! This isn't <em>really</em> finished yet, I'll get to work soon
        though!
        {" <3"}
      </p>
    </div>
    <h2>Friends</h2>
    <div class="buttons">
      <Button88x31 url="https://iamw.ing" name="wing" title="wing" />
      <Button88x31 url="https://vendicated.dev" name="vee" title="vee" />
      <Button88x31 url="https://jadestone.dev" name="jade" title="jade" />
      <Button88x31 url="https://claration.dev" name="sammy" title="sammy" />
      <Button88x31 url="https://sadan.zip" name="sadan" title="sadan" />
      <Button88x31 url="https://kneesox.moe" name="kneesox" title="kneesox" />
      <Button88x31 url="https://mugman.tech" name="mugman" title="mugman" />
      <Button88x31 url="https://amy.rip" name="amy" title="amy" />
      <Button88x31 url="https://nurmarv.in" name="marvin" title="marvin" />
      <Button88x31 url="https://uguu.tngl.io" name="keiran" title="keiran" />
      <Button88x31 url="https://mae.snp.cat" name="mae" title="mae" />
    </div>
    <Seperator />
    <div class="footer">
      <p>
        Made with <a href="https://astro.build/">Astro</a>!
      </p>
    </div>
  </div>

  <style>
    .parent {
      display: flex;
      flex-direction: column;
      margin: 2.5em;
    }
    .header {
      display: flex;
      gap: 1.5em;
    }
    .avatar {
      border-radius: 50%;
      width: 5.5em;
      height: 5.5em;
    }
    .aboutme {
      display: flex;
      gap: 1.5em;
      font-size: 1.8em;
    }
    .buttons {
      display: flex;
      gap: 1em;
      flex-wrap: wrap;
    }
    .footer {
      font-size: 1.5em;
      text-align: center;
      margin-top: 2em;
    }
  </style>
</Base>
