---
import Base from "../base.astro";
---

<Base>
  <div class="parent">
    <div class="header">
      <img
        class="avatar"
        src="https://dp.nea.moe/avatar/776037479094550529.png"
      />
      <h1>Noemi's site</h1>
    </div>
  </div>
</Base>
<style>
  .parent {
    display: flex;
    margin: 2.5em;
  }
  .header {
    display: flex;
    gap: 1.5em;
  }
  .avatar {
    border-radius: 50%;
    width: 5.5em;
    height: 5.5em;
  }
</style>
